<div id="giscus_thread" style="max-width: {{ site.max_width }}; margin: 0 auto;">
  {% if site.giscus.repo %}
    <script>
      let giscusTheme = determineComputedTheme();
      let giscusAttributes = {
        src: 'https://giscus.app/client.js',
        'data-repo': {{ site.giscus.repo | jsonify }},
        'data-repo-id': {{ site.giscus.repo_id | jsonify }},
        'data-category': {{ site.giscus.category | jsonify }},
        'data-category-id': {{ site.giscus.category_id | jsonify }},
        'data-mapping': {{ site.giscus.mapping | jsonify }},
        'data-strict': {{ site.giscus.strict | jsonify }},
        'data-reactions-enabled': {{ site.giscus.reactions_enabled | jsonify }},
        'data-emit-metadata': {{ site.giscus.emit_metadata | jsonify }},
        'data-input-position': {{ site.giscus.input_position | jsonify }},
        'data-theme': giscusTheme,
        'data-lang': {{ site.giscus.lang | jsonify }},
        crossorigin: 'anonymous',
        async: '',
      };

      let giscusScript = document.createElement('script');
      Object.entries(giscusAttributes).forEach(([key, value]) => giscusScript.setAttribute(key, value));
      document.getElementById('giscus_thread').appendChild(giscusScript);
    </script>
    <noscript>Please enable JavaScript to view the <a href="http://giscus.app/?ref_noscript">comments powered by giscus.</a></noscript>
  {% else %}
    {% capture giscus_warning %} > ##### giscus comments misconfigured > Please follow instructions at
  [http://giscus.app](http://giscus.app) and update your giscus configuration. {: .block-danger } {% endcapture %}
    {{ giscus_warning | markdownify }}
  {% endif %}
</div>
